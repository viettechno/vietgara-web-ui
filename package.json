{
  "name": "@vietgara/web-ui",
  "version": "0.1.0",
  "private": true,
  "description": "VietGara web design system: tokens, Tailwind theme and React components shared by vietgara-owner-web and vietgara-admin-web. Ships TypeScript source; the consuming app's Vite build compiles it.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "dev": "vite --config dev/vite.config.ts",
    "build:gallery": "vite build --config dev/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "latest",
    "motion": "^14.0.0",
    "radix-ui": "^1.7.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@tailwindcss/vite": "latest",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "react": "latest",
    "react-dom": "latest",
    "tailwindcss": "latest",
    "typescript": "~5.9.3",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
